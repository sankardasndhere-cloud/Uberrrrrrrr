<script data-node-id="node-e1d8n44ac">
  // ============================================================
  // STATE & HELPERS
  // ============================================================
  const state = {
    mpg: 32,
    mpgSource: 'EPA / FuelEconomy.gov (combined)',
    customMpg: null,
    fuelMethod: 'spent',
    vehicle: { year: '2022', make: 'Toyota', model: 'Camry', trim: 'LE 2.5L' },
    isEV: false,
    history: JSON.parse(localStorage.getItem('td_history') || '[]'),
    savedVehicle: JSON.parse(localStorage.getItem('td_vehicle') || 'null'),
  };

  function fmt(n, dec = 2) { return '$' + Number(n).toFixed(dec); }
  function safeDiv(a, b) { return b > 0 ? a / b : 0; }

  function updateTotalGross() {
    const g = parseFloat(document.getElementById('grossEarnings').value) || 0;
    const t = parseFloat(document.getElementById('tips').value) || 0;
    const b = parseFloat(document.getElementById('bonuses').value) || 0;
    const o = parseFloat(document.getElementById('otherIncome').value) || 0;
    const total = g + t + b + o;
    document.getElementById('totalGrossDisplay').textContent = fmt(total);
    return total;
  }

  // ============================================================
  // VEHICLE SELECTOR ARCHITECTURE (mock EPA database)
  // ============================================================
  const vehicleDB = {
    'Toyota': {
      'Camry': { trims: ['LE 2.5L', 'SE 2.5L', 'XLE 2.5L', 'Hybrid LE'], mpg: { 'LE 2.5L': 32, 'SE 2.5L': 31, 'XLE 2.5L': 30, 'Hybrid LE': 52 } },
      'Corolla': { trims: ['L 1.8L', 'LE 1.8L', 'SE 1.8L', 'Hybrid LE'], mpg: { 'L 1.8L': 34, 'LE 1.8L': 34, 'SE 1.8L': 33, 'Hybrid LE': 52 } },
      'RAV4': { trims: ['LE 2.5L', 'XLE 2.5L', 'Hybrid LE', 'Prime SE'], mpg: { 'LE 2.5L': 30, 'XLE 2.5L': 29, 'Hybrid LE': 40, 'Prime SE': 38 } },
      'Prius': { trims: ['L Eco', 'LE', 'XLE', 'Limited'], mpg: { 'L Eco': 56, 'LE': 52, 'XLE': 52, 'Limited': 52 } },
    },
    'Honda': {
      'Civic': { trims: ['LX 2.0L', 'Sport 2.0L', 'EX 1.5T'], mpg: { 'LX 2.0L': 33, 'Sport 2.0L': 30, 'EX 1.5T': 36 } },
      'Accord': { trims: ['LX 1.5T', 'Sport 1.5T', 'EX-L 1.5T', 'Hybrid'], mpg: { 'LX 1.5T': 32, 'Sport 1.5T': 31, 'EX-L 1.5T': 32, 'Hybrid': 48 } },
      'CR-V': { trims: ['LX 1.5T', 'EX 1.5T', 'Hybrid LX'], mpg: { 'LX 1.5T': 30, 'EX 1.5T': 29, 'Hybrid LX': 40 } },
    },
    'Tesla': {
      'Model 3': { trims: ['RWD', 'Long Range', 'Performance'], mpg: null, ev: { 'RWD': 132, 'Long Range': 134, 'Performance': 118 } },
      'Model Y': { trims: ['RWD', 'Long Range', 'Performance'], mpg: null, ev: { 'RWD': 129, 'Long Range': 122, 'Performance': 112 } },
    },
    'Ford': {
      'F-150': { trims: ['XL 3.3L', 'XLT 2.7L', 'Lariat 5.0L', 'Lightning'], mpg: { 'XL 3.3L': 20, 'XLT 2.7L': 22, 'Lariat 5.0L': 19, 'Lightning': 70 } },
      'Escape': { trims: ['S 1.5L', 'SE 1.5L', 'Titanium 2.0L', 'Hybrid'], mpg: { 'S 1.5L': 30, 'SE 1.5L': 30, 'Titanium 2.0L': 28, 'Hybrid': 41 } },
    },
  };

  function populateMakes() {
    const makeSelect = document.getElementById('vehicleMake');
    const makes = Object.keys(vehicleDB);
    makeSelect.innerHTML = '<option value="">Select make</option>' + makes.map(m => `<option value="${m}" ${m === state.vehicle.make ? 'selected' : ''}>${m}</option>`).join('');
    populateModels();
  }

  function populateModels() {
    const make = document.getElementById('vehicleMake').value;
    const modelSelect = document.getElementById('vehicleModel');
    if (!make || !vehicleDB[make]) {
      modelSelect.innerHTML = '<option value="">Select model</option>';
      document.getElementById('vehicleTrim').innerHTML = '<option value="">Select trim</option>';
      return;
    }
    const models = Object.keys(vehicleDB[make]);
    modelSelect.innerHTML = '<option value="">Select model</option>' + models.map(m => `<option value="${m}" ${m === state.vehicle.model ? 'selected' : ''}>${m}</option>`).join('');
    populateTrims();
  }

  function populateTrims() {
    const make = document.getElementById('vehicleMake').value;
    const model = document.getElementById('vehicleModel').value;
    const trimSelect = document.getElementById('vehicleTrim');
    if (!make || !model || !vehicleDB[make]?.[model]) {
      trimSelect.innerHTML = '<option value="">Select trim</option>';
      return;
    }
    const trims = vehicleDB[make][model].trims;
    trimSelect.innerHTML = '<option value="">Select trim</option>' + trims.map(t => `<option value="${t}" ${t === state.vehicle.trim ? 'selected' : ''}>${t}</option>`).join('');
    updateMPGFromVehicle();
  }

  function updateMPGFromVehicle() {
    const make = document.getElementById('vehicleMake').value;
    const model = document.getElementById('vehicleModel').value;
    const trim = document.getElementById('vehicleTrim').value;
    if (!make || !model) return;
    const data = vehicleDB[make]?.[model];
    if (!data) return;

    if (data.ev) {
      // EV mode
      state.isEV = true;
      state.mpg = null;
      const eff = data.ev[trim] || data.ev[Object.keys(data.ev)[0]];
      document.getElementById('mpgDisplay').textContent = eff + ' kWh/100mi';
      document.getElementById('mpgSource').textContent = 'Source: EPA / FuelEconomy.gov (electric)';
      document.getElementById('fuelSpentPanel').classList.add('hidden');
      document.getElementById('fuelCalcPanel').classList.remove('hidden');
      // Adjust labels for EV
      document.querySelector('#fuelCalcPanel .input-group:nth-child(1) .input-label').textContent = 'Miles driven today';
      document.querySelector('#fuelCalcPanel .input-group:nth-child(2) .input-label').textContent = 'Electricity price ($/kWh)';
    } else {
      state.isEV = false;
      const mpg = data.mpg[trim] || data.mpg[Object.keys(data.mpg)[0]] || 30;
      state.mpg = mpg;
      document.getElementById('mpgDisplay').textContent = mpg;
      document.getElementById('mpgSource').textContent = 'Source: EPA / FuelEconomy.gov (combined)';
      document.getElementById('fuelSpentPanel').classList.remove('hidden');
      document.getElementById('fuelCalcPanel').classList.add('hidden');
    }
    if (state.customMpg) {
      document.getElementById('mpgDisplay').textContent = state.customMpg;
      document.getElementById('mpgSource').textContent = 'Using your custom MPG';
    }
  }

  // ============================================================
  // FUEL CALCULATION
  // ============================================================
  function updateFuelCalc() {
    const miles = parseFloat(document.getElementById('milesForFuel').value) || 0;
    const price = parseFloat(document.getElementById('gasPrice').value) || 0;
    const mpg = state.customMpg || state.mpg || 30;
    if (state.isEV) {
      const kwhPer100 = parseFloat(document.getElementById('mpgDisplay').textContent) || 30;
      const kwh = (miles / 100) * kwhPer100;
      const cost = kwh * price;
      document.getElementById('fuelCalcResult').textContent = `Energy used: ${kwh.toFixed(1)} kWh — Charging cost: ${fmt(cost)}`;
      return cost;
    } else {
      const gallons = safeDiv(miles, mpg);
      const cost = gallons * price;
      document.getElementById('fuelCalcResult').textContent = `Gallons used: ${gallons.toFixed(1)} gal — Fuel cost: ${fmt(cost)}`;
      return cost;
    }
  }

  // ============================================================
  // MAIN CALCULATION
  // ============================================================
  function calculateAll() {
    const gross = parseFloat(document.getElementById('grossEarnings').value) || 0;
    const tips = parseFloat(document.getElementById('tips').value) || 0;
    const bonuses = parseFloat(document.getElementById('bonuses').value) || 0;
    const otherIncome = parseFloat(document.getElementById('otherIncome').value) || 0;
    const totalGross = gross + tips + bonuses + otherIncome;

    const miles = parseFloat(document.getElementById('milesDriven').value) || 0;
    const hours = parseFloat(document.getElementById('hoursDriven').value) || 0;

    // Fuel
    let fuelCost = 0;
    if (state.fuelMethod === 'spent') {
      fuelCost = parseFloat(document.getElementById('fuelSpent').value) || 0;
    } else {
      const m = parseFloat(document.getElementById('milesForFuel').value) || 0;
      const p = parseFloat(document.getElementById('gasPrice').value) || 0;
      if (state.isEV) {
        const kwhPer100 = parseFloat(document.getElementById('mpgDisplay').textContent) || 30;
        const kwh = (m / 100) * kwhPer100;
        fuelCost = kwh * p;
      } else {
        const mpg = state.customMpg || state.mpg || 30;
        fuelCost = safeDiv(m, mpg) * p;
      }
    }

    // Maintenance
    const maintRate = parseFloat(document.getElementById('maintenanceRate').value) || 0.10;
    const maintenance = miles * maintRate;

    // Depreciation
    const purchase = parseFloat(document.getElementById('purchasePrice').value) || 28000;
    const currentVal = parseFloat(document.getElementById('currentValue').value) || 18000;
    const odometer = parseFloat(document.getElementById('currentOdometer').value) || 45000;
    const replacement = parseFloat(document.getElementById('replacementMileage').value) || 200000;
    const remainingMiles = Math.max(replacement - odometer, 1);
    const depPerMile = safeDiv(purchase - currentVal, remainingMiles);
    const depreciation = miles * depPerMile;

    // Insurance
    const monthlyIns = parseFloat(document.getElementById('monthlyInsurance').value) || 180;
    const daysPerMonth = parseFloat(document.getElementById('daysPerMonth').value) || 25;
    const insuranceDaily = safeDiv(monthlyIns, daysPerMonth);

    // Registration
    const annualReg = parseFloat(document.getElementById('annualRegistration').value) || 300;
    const registrationDaily = safeDiv(annualReg, 365) * (daysPerMonth / 30);

    // Other
    const tolls = parseFloat(document.getElementById('tolls').value) || 0;
    const parking = parseFloat(document.getElementById('parking').value) || 0;
    const carWash = parseFloat(document.getElementById('carWash').value) || 0;
    const phone = parseFloat(document.getElementById('phoneCost').value) || 0;
    const otherExp = parseFloat(document.getElementById('otherExpenses').value) || 0;
    const otherTotal = tolls + parking + carWash + phone + otherExp;

    const totalCosts = fuelCost + maintenance + depreciation + insuranceDaily + registrationDaily + otherTotal;
    const realProfit = totalGross - totalCosts;

    // Metrics
    const profitPerHour = safeDiv(realProfit, hours);
    const profitPerMile = safeDiv(realProfit, miles);
    const costPerMile = safeDiv(totalCosts, miles);
    const grossPerHour = safeDiv(totalGross, hours);

    return { totalGross, fuelCost, maintenance, depreciation, insuranceDaily, registrationDaily, otherTotal, totalCosts, realProfit, profitPerHour, profitPerMile, costPerMile, grossPerHour, miles, hours };
  }

  function showResults() {
    const r = calculateAll();
    document.getElementById('realProfitHero').textContent = fmt(r.realProfit);
    document.getElementById('resGross').textContent = fmt(r.totalGross);
    document.getElementById('resFuel').textContent = '−' + fmt(r.fuelCost);
    document.getElementById('resMaintenance').textContent = '−' + fmt(r.maintenance);
    document.getElementById('resDepreciation').textContent = '−' + fmt(r.depreciation);
    document.getElementById('resInsurance').textContent = '−' + fmt(r.insuranceDaily);
    document.getElementById('resRegistration').textContent = '−' + fmt(r.registrationDaily);
    document.getElementById('resOther').textContent = '−' + fmt(r.otherTotal);
    document.getElementById('resTotalCosts').textContent = fmt(r.totalCosts);
    document.getElementById('resRealProfit').textContent = fmt(r.realProfit);

    document.getElementById('grossVsThink').textContent = fmt(r.totalGross, 0);
    document.getElementById('grossVsKeep').textContent = fmt(r.realProfit, 0);
    document.getElementById('grossVsCosts').textContent = fmt(r.totalCosts, 0);

    document.getElementById('metricProfitHour').textContent = fmt(r.profitPerHour) + '/hr';
    document.getElementById('metricProfitMile').textContent = fmt(r.profitPerMile) + '/mi';
    document.getElementById('metricCostMile').textContent = fmt(r.costPerMile) + '/mi';
    document.getElementById('metricGrossHour').textContent = fmt(r.grossPerHour) + '/hr';

    // Cost breakdown chart
    const chart = document.getElementById('costBreakdownChart');
    const items = [
      { label: 'Fuel', value: r.fuelCost, max: r.totalCosts },
      { label: 'Maintenance', value: r.maintenance, max: r.totalCosts },
      { label: 'Depreciation', value: r.depreciation, max: r.totalCosts },
      { label: 'Insurance', value: r.insuranceDaily, max: r.totalCosts },
      { label: 'Registration', value: r.registrationDaily, max: r.totalCosts },
      { label: 'Other', value: r.otherTotal, max: r.totalCosts },
    ];
    chart.innerHTML = items.map(item => `
      <div class="bar-item">
        <span class="bar-label">${item.label}</span>
        <div class="bar-track"><div class="bar-fill" style="width:${item.max > 0 ? (item.value / item.max * 100) : 0}%"></div></div>
        <span class="bar-value">${fmt(item.value, 0)}</span>
      </div>
    `).join('');

    document.getElementById('resultsSection').classList.remove('hidden');
    document.getElementById('resultsSection').scrollIntoView({ behavior: 'smooth' });
    updateDashboard();
  }

  // ============================================================
  // DASHBOARD & HISTORY
  // ============================================================
  function saveToHistory() {
    const r = calculateAll();
    const record = {
      date: new Date().toISOString().slice(0, 10),
      gross: r.totalGross,
      expenses: r.totalCosts,
      realProfit: r.realProfit,
      miles: r.miles,
      hours: r.hours,
      profitPerHour: r.profitPerHour,
    };
    state.history.unshift(record);
    if (state.history.length > 30) state.history.pop();
    localStorage.setItem('td_history', JSON.stringify(state.history));
    updateDashboard();
    alert('Calculation saved to history.');
  }

  function updateDashboard() {
    const today = new Date().toISOString().slice(0, 10);
    const todayRecords = state.history.filter(r => r.date === today);
    const todayProfit = todayRecords.reduce((s, r) => s + r.realProfit, 0);
    document.getElementById('dashTodayProfit').textContent = fmt(todayProfit);

    const weekAgo = new Date(Date.now() - 7 * 86400000).toISOString().slice(0, 10);
    const weekRecords = state.history.filter(r => r.date >= weekAgo);
    document.getElementById('dashWeekProfit').textContent = fmt(weekRecords.reduce((s, r) => s + r.realProfit, 0));

    const monthAgo = new Date(Date.now() - 30 * 86400000).toISOString().slice(0, 10);
    const monthRecords = state.history.filter(r => r.date >= monthAgo);
    document.getElementById('dashMonthProfit').textContent = fmt(monthRecords.reduce((s, r) => s + r.realProfit, 0));

    const list = document.getElementById('historyList');
    if (state.history.length === 0) {
      list.innerHTML = '<p class="text-sm text-[#5A6579]">No saved calculations yet. Calculate and save your first day.</p>';
      return;
    }
    list.innerHTML = state.history.map((rec, i) => `
      <div class="flex justify-between items-center p-3 bg-[#F8F9FC] rounded-xl text-sm">
        <div><span class="font-medium">${rec.date}</span> <span class="text-[#5A6579]">· ${rec.miles} mi · ${rec.hours} hr</span></div>
        <div class="text-right"><div class="font-bold text-[#2463EB]">${fmt(rec.realProfit)}</div><div class="text-xs text-[#5A6579]">${fmt(rec.profitPerHour)}/hr</div></div>
      </div>
    `).join('');
  }

  // ============================================================
  // SAVE VEHICLE
  // ============================================================
  function saveVehicle() {
    const vehicle = {
      year: document.getElementById('vehicleYear').value,
      make: document.getElementById('vehicleMake').value,
      model: document.getElementById('vehicleModel').value,
      trim: document.getElementById('vehicleTrim').value,
      mpg: state.customMpg || state.mpg,
      customMpg: state.customMpg,
      isEV: state.isEV,
    };
    localStorage.setItem('td_vehicle', JSON.stringify(vehicle));
    alert('Vehicle saved! It will load automatically next time.');
  }

  function loadSavedVehicle() {
    const saved = state.savedVehicle;
    if (!saved) return;
    document.getElementById('vehicleYear').value = saved.year || '2022';
    document.getElementById('vehicleMake').value = saved.make || 'Toyota';
    populateModels();
    document.getElementById('vehicleModel').value = saved.model || 'Camry';
    populateTrims();
    document.getElementById('vehicleTrim').value = saved.trim || 'LE 2.5L';
    if (saved.customMpg) {
      state.customMpg = saved.customMpg;
      document.getElementById('customMpgInput').value = saved.customMpg;
      document.getElementById('mpgDisplay').textContent = saved.customMpg;
      document.getElementById('mpgSource').textContent = 'Using your custom MPG';
      document.getElementById('mpgOverrideNote').textContent = 'Custom MPG is active.';
    }
  }

  // ============================================================
  // EVENT LISTENERS
  // ============================================================
  document.addEventListener('DOMContentLoaded', function() {
    // Mobile menu
    document.getElementById('mobileMenuBtn').addEventListener('click', () => {
      document.getElementById('mobileMenu').classList.toggle('hidden');
    });

    // Theme toggle (light default, toggles to dark)
    document.getElementById('themeToggle').addEventListener('click', () => {
      document.body.classList.toggle('dark-mode');
      alert('Theme toggle is a demo. Full dark mode available in premium version.');
    });

    // Vehicle selects
    document.getElementById('vehicleYear').addEventListener('change', () => {});
    document.getElementById('vehicleMake').addEventListener('change', populateModels);
    document.getElementById('vehicleModel').addEventListener('change', populateTrims);
    document.getElementById('vehicleTrim').addEventListener('change', updateMPGFromVehicle);

    // MPG override
    document.getElementById('changeMpgBtn').addEventListener('click', () => {
      document.getElementById('customMpgPanel').classList.toggle('hidden');
    });
    document.getElementById('saveCustomMpg').addEventListener('click', () => {
      const val = parseFloat(document.getElementById('customMpgInput').value);
      if (val > 0) {
        state.customMpg = val;
        document.getElementById('mpgDisplay').textContent = val;
        document.getElementById('mpgSource').textContent = 'Using your custom MPG';
        document.getElementById('mpgOverrideNote').textContent = 'Custom MPG is active.';
      }
    });
    document.getElementById('resetMpg').addEventListener('click', () => {
      state.customMpg = null;
      document.getElementById('customMpgInput').value = '';
      document.getElementById('mpgOverrideNote').textContent = '';
      updateMPGFromVehicle();
    });

    // Fuel method
    document.querySelectorAll('.fuel-method').forEach(btn => {
      btn.addEventListener('click', function() {
        document.querySelectorAll('.fuel-method').forEach(b => b.classList.remove('active', 'btn-primary'));
        this.classList.add('active');
        state.fuelMethod = this.dataset.method;
        if (state.fuelMethod === 'spent') {
          document.getElementById('fuelSpentPanel').classList.remove('hidden');
          document.getElementById('fuelCalcPanel').classList.add('hidden');
        } else {
          document.getElementById('fuelSpentPanel').classList.add('hidden');
          document.getElementById('fuelCalcPanel').classList.remove('hidden');
        }
      });
    });

    // Live fuel calc
    document.getElementById('milesForFuel').addEventListener('input', updateFuelCalc);
    document.getElementById('gasPrice').addEventListener('input', updateFuelCalc);

    // Live total gross
    ['grossEarnings', 'tips', 'bonuses', 'otherIncome'].forEach(id => {
      document.getElementById(id).addEventListener('input', updateTotalGross);
    });

    // Live maintenance
    document.getElementById('maintenanceRate').addEventListener('input', function() {
      const miles = parseFloat(document.getElementById('milesDriven').value) || 0;
      const rate = parseFloat(this.value) || 0;
      document.getElementById('maintenanceTotal').textContent = '= ' + fmt(miles * rate);
    });
    document.getElementById('milesDriven').addEventListener('input', function() {
      const miles = parseFloat(this.value) || 0;
      const rate = parseFloat(document.getElementById('maintenanceRate').value) || 0;
      document.getElementById('maintenanceTotal').textContent = '= ' + fmt(miles * rate);
    });

    // Live depreciation
    function updateDepreciation() {
      const purchase = parseFloat(document.getElementById('purchasePrice').value) || 28000;
      const current = parseFloat(document.getElementById('currentValue').value) || 18000;
      const odo = parseFloat(document.getElementById('currentOdometer').value) || 45000;
      const repl = parseFloat(document.getElementById('replacementMileage').value) || 200000;
      const miles = parseFloat(document.getElementById('milesDriven').value) || 0;
      const perMile = safeDiv(purchase - current, Math.max(repl - odo, 1));
      document.getElementById('depreciationTotal').textContent = '= ' + fmt(miles * perMile);
    }
    ['purchasePrice', 'currentValue', 'currentOdometer', 'replacementMileage', 'milesDriven'].forEach(id => {
      document.getElementById(id).addEventListener('input', updateDepreciation);
    });

    // Live insurance / registration
    function updateInsuranceReg() {
      const ins = parseFloat(document.getElementById('monthlyInsurance').value) || 180;
      const days = parseFloat(document.getElementById('daysPerMonth').value) || 25;
      document.getElementById('insuranceDaily').textContent = '= ' + fmt(safeDiv(ins, days)) + '/day';
      const reg = parseFloat(document.getElementById('annualRegistration').value) || 300;
      document.getElementById('registrationDaily').textContent = '= ' + fmt(safeDiv(reg, 365) * (days / 30)) + '/day';
    }
    ['monthlyInsurance', 'daysPerMonth', 'annualRegistration'].forEach(id => {
      document.getElementById(id).addEventListener('input', updateInsuranceReg);
    });

    // Calculate button
    document.getElementById('calculateBtn').addEventListener('click', showResults);

    // Save buttons
    document.getElementById('saveResultBtn').addEventListener('click', saveVehicle);
    document.getElementById('saveRecordBtn').addEventListener('click', saveToHistory);

    // Clear history
    document.getElementById('clearHistoryBtn').addEventListener('click', () => {
      if (confirm('Clear all saved history?')) {
        state.history = [];
        localStorage.removeItem('td_history');
        updateDashboard();
      }
    });

    // Break-even calculator
    document.getElementById('calcBreakEven').addEventListener('click', function() {
      const targetProfit = parseFloat(document.getElementById('targetProfit').value) || 200;
      const miles = parseFloat(document.getElementById('targetMiles').value) || 250;
      const hours = parseFloat(document.getElementById('targetHours').value) || 10;

      // Use current cost assumptions from the main form
      const r = calculateAll();
      const costPerMile = safeDiv(r.totalCosts, r.miles || 1);
      const estimatedCosts = costPerMile * miles;
      const requiredGross = targetProfit + estimatedCosts;
      const requiredGrossHour = safeDiv(requiredGross, hours);

      document.getElementById('beCosts').textContent = fmt(estimatedCosts);
      document.getElementById('beDesired').textContent = fmt(targetProfit);
      document.getElementById('beGross').textContent = fmt(requiredGross);
      document.getElementById('beGrossHour').textContent = fmt(requiredGrossHour) + '/hr';
      document.getElementById('breakEvenResult').classList.remove('hidden');
    });

    // Initialize
    populateMakes();
    loadSavedVehicle();
    updateTotalGross();
    updateDashboard();
    updateFuelCalc();
    updateDepreciation();
    updateInsuranceReg();

    // Set initial MPG
    updateMPGFromVehicle();
  });
</script>

<script>if(window.lucide) lucide.createIcons();</script></body></html>
